{
  "name": "arrpi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "playwright test",
    "types": "node scripts/public-types.mjs && node scripts/api-types.mjs",
    "types:check": "node scripts/public-types.mjs --check && node scripts/api-types.mjs --check && tsc --noEmit --skipLibCheck false --target es2022 --moduleResolution bundler --module esnext ../third_party/native-types/*.d.ts",
    "types:fetch": "node scripts/api-types.mjs --fetch",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.2",
    "ahooks": "3.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "get-nonce": "1.0.1",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@wowlab/eslint-config": "0.1.3",
    "eslint": "10.8.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.4",
    "prettier-plugin-sh": "0.20.2",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
